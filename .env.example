# ==========================================
# BACKEND ENVIRONMENT VARIABLES (Spring Boot)
# ==========================================
# Server port
PORT=8080

# Spring Profiles: 'default' for H2 in-memory, 'prod' for MySQL
SPRING_PROFILES_ACTIVE=default

# Production MySQL Credentials (when SPRING_PROFILES_ACTIVE=prod)
DB_URL=jdbc:mysql://localhost:3306/supermarket_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Allowed CORS Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (Vite)
# ==========================================
# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8080/api
