# ==============================================================================
# FreshCart Supermarket — Environment Configuration Template
# Copy this file to .env before starting Docker Compose or local deployment.
# NEVER commit your real .env file with actual secrets to version control.
# ==============================================================================

# --- DATABASE CONFIGURATION (MySQL Production Stack) ---
DB_NAME=supermarket_db
DB_USER=freshcart_user
DB_PASSWORD=replace_with_strong_database_password_32char
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password_32char

# --- SPRING BOOT BACKEND CONFIGURATION ---
# 'default' runs H2 in-memory development database; 'prod' connects to MySQL
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# When running with local Docker Compose:
DB_URL=jdbc:mysql://mysql:3306/supermarket_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=freshcart_user

# When deploying to Render with Aiven Managed MySQL (TLS Required):
# DB_URL=jdbc:mysql://mysql-38f2956d-freshcart-project.i.aivencloud.com:20119/defaultdb?sslMode=REQUIRED
# DB_USERNAME=avnadmin
# DB_PASSWORD=replace_with_your_aiven_password

# Admin Portal Master Key (Required for /api/admin/** operations)
FRESHCART_ADMIN_KEY=replace_with_strong_admin_key_uuid

# Allowed CORS Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000

# --- FRONTEND CONFIGURATION (Vite) ---
# When deployed behind Nginx reverse proxy (standard Docker / Production stack),
# use relative /api for same-origin routing (avoids all CORS and port issues):
VITE_API_BASE_URL=/api

# If deploying frontend and backend to separate domains/origins (e.g., Vercel + Render):
# VITE_API_BASE_URL=https://api.yourdomain.com/api

